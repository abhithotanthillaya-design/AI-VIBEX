APP_NAME=QUEUELESS API
ENVIRONMENT=development
DATABASE_PATH=./queueless.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Kolkata
SLOT_DURATION_MINUTES=5
SLOT_CAPACITY_UNITS=12
SLOT_LOOKAHEAD_MINUTES=45
ENABLE_DEMO_RESET=true
SESSION_COOKIE_NAME=queueless_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SAMESITE=lax
# Leave SESSION_COOKIE_SECURE unset to auto-enable in production HTTPS
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

